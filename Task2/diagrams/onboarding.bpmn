<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="VitaStoreOnboarding" targetNamespace="https://example.invalid/vitastore/bpmn" exporter="VitaStore coursework generator">
  <bpmn:message id="m1_message" name="m1" />
  <bpmn:message id="m2_message" name="m2" />
  <bpmn:message id="m3_message" name="m3" />
  <bpmn:message id="m4_message" name="m4" />
  <bpmn:message id="m5_message" name="m5" />
  <bpmn:message id="m6_message" name="m6" />
  <bpmn:message id="m7_message" name="m7" />
  <bpmn:message id="m8_message" name="m8" />
  <bpmn:message id="m9_message" name="m9" />
  <bpmn:message id="m10_message" name="m10" />
  <bpmn:process id="Store_process" name="Магазин / Store Ops — люди" isExecutable="false">
    <bpmn:startEvent id="StoreStart" name="Начать">
      <bpmn:outgoing>s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Export" name="Экспорт данных и профиль устройств">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Upload" name="Загрузить пакет">
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
      <bpmn:incoming>s7</bpmn:incoming>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Result" name="Получить результат">
      <bpmn:incoming>s3</bpmn:incoming>
      <bpmn:outgoing>s4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Released" name="Пакет выпущен?">
      <bpmn:incoming>s4</bpmn:incoming>
      <bpmn:outgoing>s5</bpmn:outgoing>
      <bpmn:outgoing>s6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Smoke" name="Проверить цены, HAL и offline cash">
      <bpmn:incoming>s5</bpmn:incoming>
      <bpmn:outgoing>s8</bpmn:outgoing>
      <bpmn:incoming>s11</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Ready" name="Тест пройден?">
      <bpmn:incoming>s8</bpmn:incoming>
      <bpmn:outgoing>s9</bpmn:outgoing>
      <bpmn:outgoing>s10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Opened" name="Магазин открыт">
      <bpmn:incoming>s9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Correct" name="Исправить данные / revision">
      <bpmn:incoming>s6</bpmn:incoming>
      <bpmn:outgoing>s7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FixDevice" name="Устранить проблему устройства">
      <bpmn:incoming>s10</bpmn:incoming>
      <bpmn:outgoing>s11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="s1" sourceRef="StoreStart" targetRef="Export" name="" />
    <bpmn:sequenceFlow id="s2" sourceRef="Export" targetRef="Upload" name="" />
    <bpmn:sequenceFlow id="s3" sourceRef="Upload" targetRef="Result" name="" />
    <bpmn:sequenceFlow id="s4" sourceRef="Result" targetRef="Released" name="" />
    <bpmn:sequenceFlow id="s5" sourceRef="Released" targetRef="Smoke" name="Да">
      <bpmn:conditionExpression>released</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s6" sourceRef="Released" targetRef="Correct" name="Нет">
      <bpmn:conditionExpression>not_released</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s7" sourceRef="Correct" targetRef="Upload" name="" />
    <bpmn:sequenceFlow id="s8" sourceRef="Smoke" targetRef="Ready" name="" />
    <bpmn:sequenceFlow id="s9" sourceRef="Ready" targetRef="Opened" name="Да">
      <bpmn:conditionExpression>ready</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s10" sourceRef="Ready" targetRef="FixDevice" name="Нет">
      <bpmn:conditionExpression>not_ready</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="s11" sourceRef="FixDevice" targetRef="Smoke" name="" />
    <bpmn:dataObject id="SourceFile_object" />
    <bpmn:dataObjectReference id="SourceFile" name="CSV / XLS&#10;source_hash" dataObjectRef="SourceFile_object" />
    <bpmn:association id="SourceFile_assoc" sourceRef="Export" targetRef="SourceFile" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="Onboarding_process" name="Платформа онбординга" isExecutable="false">
    <bpmn:startEvent id="Received" name="Пакет принят">
      <bpmn:outgoing>o1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Received_event" messageRef="m1_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validate" name="Проверить файл, права и checksum">
      <bpmn:incoming>o1</bpmn:incoming>
      <bpmn:outgoing>o2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Вход корректен?">
      <bpmn:incoming>o2</bpmn:incoming>
      <bpmn:outgoing>o3</bpmn:outgoing>
      <bpmn:outgoing>o4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Normalize" name="Нормализация, exact match и кандидаты">
      <bpmn:incoming>o3</bpmn:incoming>
      <bpmn:outgoing>o5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="AskAI" name="Передать остаток ИИ">
      <bpmn:incoming>o5</bpmn:incoming>
      <bpmn:outgoing>o6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="WaitAI" name="Получить кандидатов / статус">
      <bpmn:incoming>o6</bpmn:incoming>
      <bpmn:outgoing>o7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:businessRuleTask id="Policy" name="Hard rules; auto / exceptions; выборка">
      <bpmn:incoming>o7</bpmn:incoming>
      <bpmn:outgoing>o8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="AskHuman" name="Исключения + контрольная выборка">
      <bpmn:incoming>o8</bpmn:incoming>
      <bpmn:outgoing>o9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="WaitHuman" name="Принять решение товароведа">
      <bpmn:incoming>o9</bpmn:incoming>
      <bpmn:outgoing>o10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Quality" name="Quality gate?">
      <bpmn:incoming>o10</bpmn:incoming>
      <bpmn:outgoing>o11</bpmn:outgoing>
      <bpmn:outgoing>o12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="AskERP" name="Передать mapping в ERP staging">
      <bpmn:incoming>o11</bpmn:incoming>
      <bpmn:outgoing>o13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="WaitERP" name="Получить manifest / отказ ERP">
      <bpmn:incoming>o13</bpmn:incoming>
      <bpmn:outgoing>o14</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Activated" name="ERP выпустила?">
      <bpmn:incoming>o14</bpmn:incoming>
      <bpmn:outgoing>o15</bpmn:outgoing>
      <bpmn:outgoing>o16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="NotifyOK" name="Отправить версию каталога">
      <bpmn:incoming>o15</bpmn:incoming>
      <bpmn:outgoing>o17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Done" name="Пакет выпущен">
      <bpmn:incoming>o17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="NotifyFail" name="Отправить причины отказа">
      <bpmn:incoming>o4</bpmn:incoming>
      <bpmn:incoming>o12</bpmn:incoming>
      <bpmn:incoming>o16</bpmn:incoming>
      <bpmn:outgoing>o18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Failed" name="На исправление">
      <bpmn:incoming>o18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="Received" targetRef="Validate" name="" />
    <bpmn:sequenceFlow id="o2" sourceRef="Validate" targetRef="Valid" name="" />
    <bpmn:sequenceFlow id="o3" sourceRef="Valid" targetRef="Normalize" name="Да">
      <bpmn:conditionExpression>valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o4" sourceRef="Valid" targetRef="NotifyFail" name="Нет">
      <bpmn:conditionExpression>invalid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o5" sourceRef="Normalize" targetRef="AskAI" name="" />
    <bpmn:sequenceFlow id="o6" sourceRef="AskAI" targetRef="WaitAI" name="" />
    <bpmn:sequenceFlow id="o7" sourceRef="WaitAI" targetRef="Policy" name="" />
    <bpmn:sequenceFlow id="o8" sourceRef="Policy" targetRef="AskHuman" name="" />
    <bpmn:sequenceFlow id="o9" sourceRef="AskHuman" targetRef="WaitHuman" name="" />
    <bpmn:sequenceFlow id="o10" sourceRef="WaitHuman" targetRef="Quality" name="" />
    <bpmn:sequenceFlow id="o11" sourceRef="Quality" targetRef="AskERP" name="Да">
      <bpmn:conditionExpression>quality_approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o12" sourceRef="Quality" targetRef="NotifyFail" name="Нет">
      <bpmn:conditionExpression>quality_rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o13" sourceRef="AskERP" targetRef="WaitERP" name="" />
    <bpmn:sequenceFlow id="o14" sourceRef="WaitERP" targetRef="Activated" name="" />
    <bpmn:sequenceFlow id="o15" sourceRef="Activated" targetRef="NotifyOK" name="Да">
      <bpmn:conditionExpression>activated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o16" sourceRef="Activated" targetRef="NotifyFail" name="Нет">
      <bpmn:conditionExpression>erp_rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="o17" sourceRef="NotifyOK" targetRef="Done" name="" />
    <bpmn:sequenceFlow id="o18" sourceRef="NotifyFail" targetRef="Failed" name="" />
    <bpmn:dataObject id="MappingData_object" />
    <bpmn:dataObjectReference id="MappingData" name="Mapping +&#10;master_version" dataObjectRef="MappingData_object" />
    <bpmn:association id="MappingData_assoc" sourceRef="AskERP" targetRef="MappingData" associationDirection="None" />
  </bpmn:process>
  <bpmn:process id="AI_process" name="ИИ-сервис — система" isExecutable="false">
    <bpmn:startEvent id="AIStart" name="Запрос">
      <bpmn:outgoing>a1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="AIStart_event" messageRef="m2_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Rank" name="Извлечь признаки и ранжировать candidate IDs">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:outgoing>a2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="AIPublish" name="Кандидаты, score, версия / ошибка">
      <bpmn:incoming>a2</bpmn:incoming>
      <bpmn:outgoing>a3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="AIEnd" name="Ответ">
      <bpmn:incoming>a3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="a1" sourceRef="AIStart" targetRef="Rank" name="" />
    <bpmn:sequenceFlow id="a2" sourceRef="Rank" targetRef="AIPublish" name="" />
    <bpmn:sequenceFlow id="a3" sourceRef="AIPublish" targetRef="AIEnd" name="" />
  </bpmn:process>
  <bpmn:process id="Human_process" name="Товаровед HQ — человек" isExecutable="false">
    <bpmn:startEvent id="HumanStart" name="На проверку">
      <bpmn:outgoing>h1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="HumanStart_event" messageRef="m4_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="Review" name="Проверить исключения и выборку; принять / отклонить">
      <bpmn:incoming>h1</bpmn:incoming>
      <bpmn:outgoing>h2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="ReviewReply" name="Mapping + решение + audit">
      <bpmn:incoming>h2</bpmn:incoming>
      <bpmn:outgoing>h3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="HumanEnd" name="Проверено">
      <bpmn:incoming>h3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="h1" sourceRef="HumanStart" targetRef="Review" name="" />
    <bpmn:sequenceFlow id="h2" sourceRef="Review" targetRef="ReviewReply" name="" />
    <bpmn:sequenceFlow id="h3" sourceRef="ReviewReply" targetRef="HumanEnd" name="" />
  </bpmn:process>
  <bpmn:process id="ERP_process" name="SAP ERP — система" isExecutable="false">
    <bpmn:startEvent id="ERPStart" name="Mapping">
      <bpmn:outgoing>e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ERPStart_event" messageRef="m6_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ERPValidate" name="Staging: SKU, единицы, цены, master_version">
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ERPValid" name="Контроли OK?">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
      <bpmn:outgoing>e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ERPActivate" name="Идемпотентный commit версии">
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="ERPReply" name="Manifest выпущенного каталога">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ERPEnd" name="Готово">
      <bpmn:incoming>e6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="ERPReject" name="Отказ + причины">
      <bpmn:incoming>e4</bpmn:incoming>
      <bpmn:outgoing>e7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="ERPBadEnd" name="Не опубликовано">
      <bpmn:incoming>e7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e1" sourceRef="ERPStart" targetRef="ERPValidate" name="" />
    <bpmn:sequenceFlow id="e2" sourceRef="ERPValidate" targetRef="ERPValid" name="" />
    <bpmn:sequenceFlow id="e3" sourceRef="ERPValid" targetRef="ERPActivate" name="Да">
      <bpmn:conditionExpression>erp_checks_ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e4" sourceRef="ERPValid" targetRef="ERPReject" name="Нет">
      <bpmn:conditionExpression>erp_checks_failed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e5" sourceRef="ERPActivate" targetRef="ERPReply" name="" />
    <bpmn:sequenceFlow id="e6" sourceRef="ERPReply" targetRef="ERPEnd" name="" />
    <bpmn:sequenceFlow id="e7" sourceRef="ERPReject" targetRef="ERPBadEnd" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Store_pool" name="Магазин / Store Ops — люди" processRef="Store_process" />
    <bpmn:participant id="Onboarding_pool" name="Платформа онбординга" processRef="Onboarding_process" />
    <bpmn:participant id="AI_pool" name="ИИ-сервис — система" processRef="AI_process" />
    <bpmn:participant id="Human_pool" name="Товаровед HQ — человек" processRef="Human_process" />
    <bpmn:participant id="ERP_pool" name="SAP ERP — система" processRef="ERP_process" />
    <bpmn:messageFlow id="m1" sourceRef="Upload" targetRef="Received" messageRef="m1_message" name="CSV/XLS + hash" />
    <bpmn:messageFlow id="m2" sourceRef="AskAI" targetRef="AIStart" messageRef="m2_message" name="Кандидаты + master_version" />
    <bpmn:messageFlow id="m3" sourceRef="AIPublish" targetRef="WaitAI" messageRef="m3_message" name="Ответ / ошибка ИИ" />
    <bpmn:messageFlow id="m4" sourceRef="AskHuman" targetRef="HumanStart" messageRef="m4_message" name="Проверка exceptions + sample" />
    <bpmn:messageFlow id="m5" sourceRef="ReviewReply" targetRef="WaitHuman" messageRef="m5_message" name="Решение HQ" />
    <bpmn:messageFlow id="m6" sourceRef="AskERP" targetRef="ERPStart" messageRef="m6_message" name="Batch mapping + audit" />
    <bpmn:messageFlow id="m7" sourceRef="ERPReply" targetRef="WaitERP" messageRef="m7_message" name="Manifest / status" />
    <bpmn:messageFlow id="m8" sourceRef="ERPReject" targetRef="WaitERP" messageRef="m8_message" name="Rejection" />
    <bpmn:messageFlow id="m9" sourceRef="NotifyOK" targetRef="Result" messageRef="m9_message" name="Версия каталога" />
    <bpmn:messageFlow id="m10" sourceRef="NotifyFail" targetRef="Result" messageRef="m10_message" name="Причины отказа" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Store_pool_di" bpmnElement="Store_pool" isHorizontal="true">
        <dc:Bounds x="70" y="80" width="1990" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Onboarding_pool_di" bpmnElement="Onboarding_pool" isHorizontal="true">
        <dc:Bounds x="70" y="370" width="1990" height="460" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AI_pool_di" bpmnElement="AI_pool" isHorizontal="true">
        <dc:Bounds x="70" y="870" width="1990" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Human_pool_di" bpmnElement="Human_pool" isHorizontal="true">
        <dc:Bounds x="70" y="1060" width="1990" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ERP_pool_di" bpmnElement="ERP_pool" isHorizontal="true">
        <dc:Bounds x="70" y="1250" width="1990" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StoreStart_di" bpmnElement="StoreStart">
        <dc:Bounds x="150" y="144" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Export_di" bpmnElement="Export">
        <dc:Bounds x="220" y="125" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Upload_di" bpmnElement="Upload">
        <dc:Bounds x="450" y="125" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Result_di" bpmnElement="Result">
        <dc:Bounds x="700" y="125" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Released_di" bpmnElement="Released">
        <dc:Bounds x="940" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Smoke_di" bpmnElement="Smoke">
        <dc:Bounds x="1040" y="125" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ready_di" bpmnElement="Ready">
        <dc:Bounds x="1280" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Opened_di" bpmnElement="Opened">
        <dc:Bounds x="1490" y="144" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Correct_di" bpmnElement="Correct">
        <dc:Bounds x="710" y="235" width="180" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FixDevice_di" bpmnElement="FixDevice">
        <dc:Bounds x="1290" y="235" width="210" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Received_di" bpmnElement="Received">
        <dc:Bounds x="150" y="419" width="32" height="32" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Validate_di" bpmnElement="Validate">
        <dc:Bounds x="230" y="400" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid">
        <dc:Bounds x="455" y="410" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Normalize_di" bpmnElement="Normalize">
        <dc:Bounds x="550" y="400" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AskAI_di" bpmnElement="AskAI">
        <dc:Bounds x="790" y="400" width="180" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitAI_di" bpmnElement="WaitAI">
